{
  "name": "dsh-startup-animation",
  "version": "1.0.0",
  "description": "A six-second cinematic DeepSeek Harness desktop startup animation with a terminal-to-whale transition and optional startup audio.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "README.zh-CN.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "sideEffects": ["./lib/client.js"],
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {"platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-plugin-manager"]}
  },
  "engines": {"node": ">=22", "dsh": ">=0.2.1-rc.3 <0.3.0-0 || >=0.2.1 <0.3.0"},
  "peerDependencies": {"react": "^18.2.0"},
  "peerDependenciesMeta": {"react": {"optional": true}},
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/preferences.test.mjs",
    "check": "npm run build && npm test"
  },
  "license": "MIT",
  "author": "bilbillm",
  "repository": {"type": "git", "url": "git+https://github.com/bilbillm/dsh-startup-animation.git"},
  "homepage": "https://github.com/bilbillm/dsh-startup-animation#readme",
  "bugs": {"url": "https://github.com/bilbillm/dsh-startup-animation/issues"},
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "desktop", "startup", "animation"]
}
